// Runtime view of the catalog generated by loader/src/game_catalog.h.
// The loader reads the exact installed CS2 items_game/localization/VPK tree and
// writes one versioned binary snapshot immediately before injection.  The
// payload only consumes that snapshot; it never invents weapon/paint/model pairs.

constexpr unsigned int INVENTORY_GAME_CATALOG_MAGIC = 0x31434743u; // CGC1
constexpr unsigned short INVENTORY_GAME_CATALOG_VERSION = 1;
constexpr unsigned int INVENTORY_GAME_CATALOG_MAX_RECORDS = 8192u;
constexpr DWORD INVENTORY_GAME_MEM_COMMIT_RESERVE = 0x3000u;
constexpr DWORD INVENTORY_GAME_MEM_RELEASE = 0x8000u;
constexpr DWORD INVENTORY_GAME_PAGE_READWRITE = 0x04u;

#pragma pack(push, 1)
struct InventoryGameCatalogRecord {
    unsigned short definitionIndex;
    BYTE category;
    BYTE teamMask;
    int paintKit;
    wchar_t displayName[80];
    wchar_t weaponName[48];
    wchar_t finishName[64];
    char iconResource[160];
    char modelPlayer[160];
    char modelWorld[160];
};

struct InventoryGameCatalogHeader {
    unsigned int magic;
    unsigned short version;
    unsigned short recordSize;
    unsigned int count;
    unsigned int checksum;
};
#pragma pack(pop)

static InventoryGameCatalogRecord* g_inventoryGameCatalog = nullptr;
static unsigned int g_inventoryGameCatalogCount = 0;
static unsigned int g_inventoryGameCatalogChecksum = 0;
static bool g_inventoryGameCatalogLoaded = false;
static bool g_inventoryGameCatalogLoadAttempted = false;

static unsigned int InventoryGameCatalogChecksum(
    const InventoryGameCatalogRecord* records, unsigned int count)
{
    if (!records && count != 0)
        return 0;
    const BYTE* bytes = reinterpret_cast<const BYTE*>(records);
    const SIZE_T size = static_cast<SIZE_T>(count) *
        sizeof(InventoryGameCatalogRecord);
    unsigned int hash = 2166136261u;
    for (SIZE_T i = 0; i < size; ++i)
    {
        hash ^= bytes[i];
        hash *= 16777619u;
    }
    return hash;
}

static bool InventoryGameCatalogPath(wchar_t* path, DWORD capacity)
{
    if (!path || capacity < 64)
        return false;
    DWORD length = GetTempPathW(capacity, path);
    if (length == 0 || length >= capacity)
        return false;
    static const wchar_t suffix[] = L"cas_plus_game_catalog_v1.bin";
    DWORD suffixLength = 0;
    while (suffix[suffixLength]) ++suffixLength;
    if (length + suffixLength + 1 >= capacity)
        return false;
    for (DWORD i = 0; i <= suffixLength; ++i)
        path[length + i] = suffix[i];
    return true;
}

static void ShutdownInventoryGameCatalog()
{
    if (g_inventoryGameCatalog)
        VirtualFree(g_inventoryGameCatalog, 0, INVENTORY_GAME_MEM_RELEASE);
    g_inventoryGameCatalog = nullptr;
    g_inventoryGameCatalogCount = 0;
    g_inventoryGameCatalogChecksum = 0;
    g_inventoryGameCatalogLoaded = false;
}

static bool LoadInventoryGameCatalog()
{
    if (g_inventoryGameCatalogLoadAttempted)
        return g_inventoryGameCatalogLoaded;
    g_inventoryGameCatalogLoadAttempted = true;

    wchar_t path[512]{};
    if (!InventoryGameCatalogPath(path,
        static_cast<DWORD>(sizeof(path) / sizeof(path[0]))))
        return false;
    HANDLE file = CreateFileW(path, CAS_GENERIC_READ, CAS_FILE_SHARE_READ,
        nullptr, CAS_OPEN_EXISTING, CAS_FILE_ATTRIBUTE_NORMAL, nullptr);
    if (file == CAS_INVALID_HANDLE_VALUE)
        return false;

    InventoryGameCatalogHeader header{};
    DWORD read = 0;
    if (!ReadFile(file, &header, sizeof(header), &read, nullptr) ||
        read != sizeof(header) ||
        header.magic != INVENTORY_GAME_CATALOG_MAGIC ||
        header.version != INVENTORY_GAME_CATALOG_VERSION ||
        header.recordSize != sizeof(InventoryGameCatalogRecord) ||
        header.count == 0 ||
        header.count > INVENTORY_GAME_CATALOG_MAX_RECORDS)
    {
        CloseHandle(file);
        return false;
    }

    const SIZE_T bytes = static_cast<SIZE_T>(header.count) *
        sizeof(InventoryGameCatalogRecord);
    InventoryGameCatalogRecord* records =
        reinterpret_cast<InventoryGameCatalogRecord*>(VirtualAlloc(
            nullptr, bytes, INVENTORY_GAME_MEM_COMMIT_RESERVE,
            INVENTORY_GAME_PAGE_READWRITE));
    if (!records)
    {
        CloseHandle(file);
        return false;
    }

    DWORD recordBytes = 0;
    const BOOL ok = ReadFile(file, records, static_cast<DWORD>(bytes),
        &recordBytes, nullptr);
    CloseHandle(file);
    if (!ok || recordBytes != bytes ||
        InventoryGameCatalogChecksum(records, header.count) != header.checksum)
    {
        VirtualFree(records, 0, INVENTORY_GAME_MEM_RELEASE);
        return false;
    }

    g_inventoryGameCatalog = records;
    g_inventoryGameCatalogCount = header.count;
    g_inventoryGameCatalogChecksum = header.checksum;
    g_inventoryGameCatalogLoaded = true;
    return true;
}

static bool InventoryGameCatalogReady()
{
    return g_inventoryGameCatalogLoaded && g_inventoryGameCatalog &&
        g_inventoryGameCatalogCount > 0;
}

static const InventoryGameCatalogRecord* InventoryGameCatalogAt(
    unsigned int index)
{
    if (!InventoryGameCatalogReady() || index >= g_inventoryGameCatalogCount)
        return nullptr;
    return &g_inventoryGameCatalog[index];
}

static const InventoryGameCatalogRecord* InventoryGameCatalogFindPair(
    unsigned short definitionIndex, int paintKit)
{
    if (!InventoryGameCatalogReady())
        return nullptr;
    for (unsigned int i = 0; i < g_inventoryGameCatalogCount; ++i)
    {
        const InventoryGameCatalogRecord& record = g_inventoryGameCatalog[i];
        if (record.definitionIndex == definitionIndex &&
            record.paintKit == paintKit)
            return &record;
    }
    return nullptr;
}

static const InventoryGameCatalogRecord* InventoryGameCatalogFindFirstDefinition(
    unsigned short definitionIndex)
{
    if (!InventoryGameCatalogReady())
        return nullptr;
    for (unsigned int i = 0; i < g_inventoryGameCatalogCount; ++i)
        if (g_inventoryGameCatalog[i].definitionIndex == definitionIndex)
            return &g_inventoryGameCatalog[i];
    return nullptr;
}

static int InventoryGameCatalogCountCategory(int category)
{
    if (!InventoryGameCatalogReady() || category <= 0)
        return 0;
    int count = 0;
    for (unsigned int i = 0; i < g_inventoryGameCatalogCount; ++i)
        if (g_inventoryGameCatalog[i].category == category)
            ++count;
    return count;
}

static const InventoryGameCatalogRecord* InventoryGameCatalogCategoryOrdinal(
    int category, int ordinal, int* absoluteIndex = nullptr)
{
    if (!InventoryGameCatalogReady() || category <= 0 || ordinal < 0)
        return nullptr;
    int seen = 0;
    for (unsigned int i = 0; i < g_inventoryGameCatalogCount; ++i)
    {
        if (g_inventoryGameCatalog[i].category != category)
            continue;
        if (seen++ != ordinal)
            continue;
        if (absoluteIndex)
            *absoluteIndex = static_cast<int>(i);
        return &g_inventoryGameCatalog[i];
    }
    return nullptr;
}

static int InventoryGameCatalogCyclePaint(unsigned short definitionIndex,
    int currentPaint, int direction)
{
    if (!InventoryGameCatalogReady() || direction == 0)
        return currentPaint;
    int first = -1;
    int last = -1;
    int current = -1;
    for (unsigned int i = 0; i < g_inventoryGameCatalogCount; ++i)
    {
        const InventoryGameCatalogRecord& record = g_inventoryGameCatalog[i];
        if (record.definitionIndex != definitionIndex || record.paintKit <= 0)
            continue;
        if (first < 0) first = static_cast<int>(i);
        last = static_cast<int>(i);
        if (record.paintKit == currentPaint)
            current = static_cast<int>(i);
    }
    if (first < 0)
        return 0;
    if (current < 0)
        return direction > 0 ? g_inventoryGameCatalog[first].paintKit :
            g_inventoryGameCatalog[last].paintKit;

    int candidate = current;
    do
    {
        candidate += direction > 0 ? 1 : -1;
        if (candidate > last) candidate = first;
        if (candidate < first) candidate = last;
        if (g_inventoryGameCatalog[candidate].definitionIndex == definitionIndex &&
            g_inventoryGameCatalog[candidate].paintKit > 0)
            return g_inventoryGameCatalog[candidate].paintKit;
    } while (candidate != current);
    return currentPaint;
}

static const InventoryGameCatalogRecord* InventoryGameCatalogForItem(
    const VirtualInventoryItem& item)
{
    const InventoryGameCatalogRecord* exact = InventoryGameCatalogFindPair(
        item.overrideDefinitionIndex, item.paintKit);
    if (exact)
        return exact;
    if (item.paintKit == 0)
        return InventoryGameCatalogFindFirstDefinition(item.overrideDefinitionIndex);
    return nullptr;
}

static const wchar_t* InventoryGameCatalogDisplayName(
    const VirtualInventoryItem& item)
{
    const InventoryGameCatalogRecord* record = InventoryGameCatalogForItem(item);
    return record && record->displayName[0] ? record->displayName : nullptr;
}

static const char* InventoryGameCatalogModelPlayer(
    const VirtualInventoryItem& item)
{
    const InventoryGameCatalogRecord* record = InventoryGameCatalogForItem(item);
    return record && record->modelPlayer[0] ? record->modelPlayer : nullptr;
}

static const char* InventoryGameCatalogModelWorld(
    const VirtualInventoryItem& item)
{
    const InventoryGameCatalogRecord* record = InventoryGameCatalogForItem(item);
    return record && record->modelWorld[0] ? record->modelWorld : nullptr;
}

static const char* InventoryGameCatalogIconResource(
    const VirtualInventoryItem& item)
{
    const InventoryGameCatalogRecord* record = InventoryGameCatalogForItem(item);
    return record && record->iconResource[0] ? record->iconResource : nullptr;
}

static void InventoryGameCatalogSanitizeLoadedStore()
{
    if (!InventoryGameCatalogReady() || !InventoryTryLock())
        return;
    bool dirty = false;
    for (int i = 0; i < g_inventoryStore.itemCount; ++i)
    {
        VirtualInventoryItem& item = g_inventoryStore.items[i];
        if (item.slotDefinitionIndex == INVENTORY_SLOT_MUSIC)
            continue;
        if (item.paintKit <= 0)
            continue;
        if (InventoryGameCatalogFindPair(item.overrideDefinitionIndex,
            item.paintKit))
            continue;
        // Old versions allowed arbitrary raw paint IDs.  Keep the item itself
        // but drop an impossible pairing instead of projecting a fake skin.
        item.paintKit = 0;
        item.seed = 0;
        dirty = true;
    }
    if (dirty)
        MarkInventoryDirty();
    InventoryUnlock();
}
