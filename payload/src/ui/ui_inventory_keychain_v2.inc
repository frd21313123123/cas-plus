// cas+ keychain/charm editor. IDs/names come only from the installed-game
// attachment catalog generated by loader.exe.

static void CasUiDrawKeychainModalV2(HDC hdc)
{
    if (!g_inventoryKeychainModal)
        return;
    InventoryUiSnapshot snapshot{};
    if (!InventoryGetFilteredUiSnapshot(&snapshot) ||
        !snapshot.hasSelectedItem ||
        !InventoryKeychainSupportedSlot(snapshot.selectedItem.slotDefinitionIndex))
        return;

    InventoryKeychainState state{};
    InventoryKeychainCopy(snapshot.selectedItem.itemId, &state);
    InventoryKeychainSanitize(&state);

    DrawRoundedCard(hdc, 254, 92, 626, 452,
        RGB_COLOR(9, 11, 18), CAS_UI_BORDER_HI, 10);
    CasUiDrawRect(hdc, 254, 92, 258, 544, CAS_UI_ACCENT);
    CasUiDrawLabel(hdc, L"Charm / keychain", 280, 112, 260, 28,
        CAS_UI_TEXT, 18, 650, DT_LEFT);
    CasUiDrawLabel(hdc, CasUiInventoryDomainName(snapshot.selectedItem),
        280, 141, 300, 20, CAS_UI_MUTED, 11, 400, DT_LEFT);
    CasUiDrawButton(hdc, 786, 112, 68, 30, L"Close");

    CasUiDrawEditorSection(hdc, 280, 178, 574, 116, L"REAL GAME CHARM");
    CasUiDrawLabel(hdc, L"Name", 296, 206, 54, 20,
        CAS_UI_MUTED, 11, 500, DT_LEFT);
    CasUiDrawLabel(hdc,
        InventoryAttachmentName(INVENTORY_ATTACHMENT_KEYCHAIN, state.id),
        354, 204, 350, 24, CAS_UI_TEXT, 12, 550, DT_LEFT);
    RECT idRc = { 706, 205, 756, 226 };
    SetTextColor(hdc, CAS_UI_MUTED);
    DrawInventoryNumber(hdc, static_cast<unsigned int>(state.id),
        &idRc, DT_LEFT | DT_SINGLELINE);
    CasUiDrawButton(hdc, 296, 244, 72, 30, L"< Prev");
    CasUiDrawButton(hdc, 376, 244, 72, 30, L"Next >");
    CasUiDrawButton(hdc, 760, 244, 78, 30, L"Remove");

    CasUiDrawEditorSection(hdc, 280, 306, 574, 136, L"PATTERN & PLACEMENT");
    CasUiDrawLabel(hdc, L"Pattern", 296, 334, 64, 20,
        CAS_UI_MUTED, 11, 500, DT_LEFT);
    RECT seedRc = { 362, 333, 438, 354 };
    SetTextColor(hdc, CAS_UI_TEXT);
    DrawInventoryNumber(hdc, static_cast<unsigned int>(state.seed),
        &seedRc, DT_LEFT | DT_SINGLELINE);
    CasUiDrawButton(hdc, 446, 328, 48, 28, L"-100");
    CasUiDrawButton(hdc, 500, 328, 42, 28, L"-1");
    CasUiDrawButton(hdc, 548, 328, 42, 28, L"+1");
    CasUiDrawButton(hdc, 596, 328, 54, 28, L"+100");

    wchar_t xText[16]{}, yText[16]{}, zText[16]{};
    CasUiFormatSignedHundredths(state.offsetX, xText,
        static_cast<int>(sizeof(xText) / sizeof(xText[0])));
    CasUiFormatSignedHundredths(state.offsetY, yText,
        static_cast<int>(sizeof(yText) / sizeof(yText[0])));
    CasUiFormatSignedHundredths(state.offsetZ, zText,
        static_cast<int>(sizeof(zText) / sizeof(zText[0])));

    CasUiDrawLabel(hdc, L"X", 296, 384, 18, 20,
        CAS_UI_MUTED, 11, 600, DT_LEFT);
    CasUiDrawLabel(hdc, xText, 316, 384, 52, 20,
        CAS_UI_TEXT, 10, 550, DT_LEFT);
    CasUiDrawButton(hdc, 370, 378, 46, 28, L"-.01");
    CasUiDrawButton(hdc, 420, 378, 46, 28, L"+.01");

    CasUiDrawLabel(hdc, L"Y", 486, 384, 18, 20,
        CAS_UI_MUTED, 11, 600, DT_LEFT);
    CasUiDrawLabel(hdc, yText, 506, 384, 52, 20,
        CAS_UI_TEXT, 10, 550, DT_LEFT);
    CasUiDrawButton(hdc, 560, 378, 46, 28, L"-.01");
    CasUiDrawButton(hdc, 610, 378, 46, 28, L"+.01");

    CasUiDrawLabel(hdc, L"Z", 676, 384, 18, 20,
        CAS_UI_MUTED, 11, 600, DT_LEFT);
    CasUiDrawLabel(hdc, zText, 696, 384, 52, 20,
        CAS_UI_TEXT, 10, 550, DT_LEFT);
    CasUiDrawButton(hdc, 748, 378, 42, 28, L"-.01");
    CasUiDrawButton(hdc, 796, 378, 42, 28, L"+.01");

    CasUiDrawLabel(hdc,
        L"Charm ID, name, icon and model are parsed from this installed CS2 build.",
        280, 468, 558, 28, CAS_UI_MUTED_2, 10, 400, DT_LEFT);
    CasUiDrawLabel(hdc,
        L"Offsets follow Source 2 keychain slot 0 attributes; no arbitrary IDs.",
        280, 494, 558, 24, CAS_UI_MUTED_2, 10, 400, DT_LEFT);
}

static bool CasUiHandleKeychainModalV2Click(int mouseX, int mouseY)
{
    if (!g_inventoryKeychainModal)
        return false;
    if (CasUiPointInRect(mouseX, mouseY, 786, 112, 68, 30))
        InventoryUiCloseKeychainModal();
    else if (CasUiPointInRect(mouseX, mouseY, 296, 244, 72, 30))
        InventoryUiCycleKeychain(-1);
    else if (CasUiPointInRect(mouseX, mouseY, 376, 244, 72, 30))
        InventoryUiCycleKeychain(1);
    else if (CasUiPointInRect(mouseX, mouseY, 760, 244, 78, 30))
        InventoryUiRemoveKeychain();
    else if (CasUiPointInRect(mouseX, mouseY, 446, 328, 48, 28))
        InventoryUiAdjustKeychainSeed(-100);
    else if (CasUiPointInRect(mouseX, mouseY, 500, 328, 42, 28))
        InventoryUiAdjustKeychainSeed(-1);
    else if (CasUiPointInRect(mouseX, mouseY, 548, 328, 42, 28))
        InventoryUiAdjustKeychainSeed(1);
    else if (CasUiPointInRect(mouseX, mouseY, 596, 328, 54, 28))
        InventoryUiAdjustKeychainSeed(100);
    else if (CasUiPointInRect(mouseX, mouseY, 370, 378, 46, 28))
        InventoryUiAdjustKeychainOffsetX(-0.01f);
    else if (CasUiPointInRect(mouseX, mouseY, 420, 378, 46, 28))
        InventoryUiAdjustKeychainOffsetX(0.01f);
    else if (CasUiPointInRect(mouseX, mouseY, 560, 378, 46, 28))
        InventoryUiAdjustKeychainOffsetY(-0.01f);
    else if (CasUiPointInRect(mouseX, mouseY, 610, 378, 46, 28))
        InventoryUiAdjustKeychainOffsetY(0.01f);
    else if (CasUiPointInRect(mouseX, mouseY, 748, 378, 42, 28))
        InventoryUiAdjustKeychainOffsetZ(-0.01f);
    else if (CasUiPointInRect(mouseX, mouseY, 796, 378, 42, 28))
        InventoryUiAdjustKeychainOffsetZ(0.01f);
    return true;
}
